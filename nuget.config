<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    BepInEx and Unity's reference assemblies are only on BepInEx's own feed. Source mapping keeps every
    other package on nuget.org, so that feed can never stand in for one of them (as in LaunchHeim).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="bepinex">
      <package pattern="BepInEx.Core" />
      <package pattern="BepInEx.BaseLib" />
      <package pattern="UnityEngine.Modules" />
    </packageSource>
  </packageSourceMapping>
</configuration>
